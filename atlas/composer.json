{
    "name": "error404/atlas",
    "description": "ATLAS — Plataforma Inteligente de Aprendizaje Adaptativo (aplicación PHP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": { "Atlas\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Atlas\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
