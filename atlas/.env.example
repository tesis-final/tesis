# =============================================================================
# ATLAS — variables de entorno de ejemplo (CT-12).
# En producción, copiar a /srv/atlas/config/atlas.conf, completar con valores
# reales, dejar con modo 640 root:atlas-admin y proteger con `chattr +i`.
# NUNCA subir el archivo con valores reales a Git.
# =============================================================================

# --- Rutas en atlas-srv01 (§28.3) ---
ATLAS_WEB=/srv/atlas/web
ATLAS_DATOS=/srv/atlas/datos
ATLAS_LOGS=/srv/atlas/logs
ATLAS_TLS_DIR=/srv/atlas/config/tls
ATLAS_CONF=/srv/atlas/config/atlas.conf
ANALYSIS_BUILD_CONTEXT=/srv/atlas/web/analysis
ATLAS_BIND_IP=172.16.40.10
ATLAS_MYSQL_IMAGE=mysql:8.0

# --- MySQL: contraseñas de los usuarios de la Tabla 21 (generar con: openssl rand -base64 24) ---
MYSQL_ROOT_PASSWORD=CAMBIAR
ATLAS_DB_NAME=atlas_db
ATLAS_DB_APP_USER=atlas_app
ATLAS_DB_APP_PASSWORD=CAMBIAR
ATLAS_DB_READ_USER=atlas_read
ATLAS_DB_READ_PASSWORD=CAMBIAR
ATLAS_DB_ANALYSIS_USER=atlas_analysis
ATLAS_DB_ANALYSIS_PASSWORD=CAMBIAR
ATLAS_DB_BACKUP_PASSWORD=CAMBIAR
ATLAS_DB_ADMIN_PASSWORD=CAMBIAR
ATLAS_DB_ALLOWED_HOST=192.168.250.16/255.255.255.240

# --- Aplicación ---
ATLAS_COOKIE_SECURE=true
ATLAS_SESSION_IDLE_MINUTES=30
ATLAS_LOGIN_MAX_INTENTOS=3
ATLAS_LOGIN_BLOQUEO_MINUTOS=15
ATLAS_ANALYSIS_TIMEOUT=5

# --- Primer administrador (php bin/atlas usuario:crear-admin) ---
ATLAS_ADMIN_NOMBRE=Coordinación
ATLAS_ADMIN_APELLIDO=ITI
ATLAS_ADMIN_CORREO=coordinacion@atlas.local
ATLAS_ADMIN_CONTRASENA=CAMBIAR-min-10-caracteres

# --- Servicio de análisis y LLM (DEC-24: Groq, API compatible con OpenAI) ---
LLM_PROVIDER=groq
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=CAMBIAR
LLM_TIMEOUT=25
ML_MIN_ESTUDIANTES=20
ML_MIN_INTENTOS_POR_ESTUDIANTE=5

# --- Solo para datos de demostración (bin/atlas demo:datos-sinteticos) ---
ATLAS_DEMO_CONTRASENA=CAMBIAR-min-10-caracteres
