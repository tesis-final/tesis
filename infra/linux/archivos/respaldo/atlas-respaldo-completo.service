# ATLAS — respaldo completo (base, archivos con ACL, usuarios y permisos) (§28.5, Tabla 29). Lo arranca atlas-respaldo-completo.timer.
[Unit]
Description=ATLAS · respaldo completo (base, archivos con ACL, usuarios y permisos)
After=docker.service atlas.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/atlas-respaldo completo
Nice=10
IOSchedulingClass=idle
