# ATLAS — verificación diaria de los respaldos (§28.5, Tabla 29). Lo arranca atlas-respaldo-verificar.timer.
[Unit]
Description=ATLAS · verificación diaria de los respaldos
After=docker.service atlas.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/atlas-respaldo verificar
Nice=10
IOSchedulingClass=idle
