# ATLAS — verificación de los respaldos: todos los días 03:30 (§28.5, Tabla 29). Persistent: si el servidor estaba apagado, corre al prender.
[Unit]
Description=ATLAS · verificación de los respaldos: todos los días 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
